extends RefCounted
## Метаданные приложения (версия, подписи на splash / О программе).
##
## Схема MAJOR.MINOR.PATCH (пока < 1.0 — продукт в разработке):
##   MAJOR — ломающие изменения (.msim, педагогика, «другой продукт»); 1.0 = готово к выдаче
##   MINOR — заметный функциональный блок (новый класс аппаратов, режим симуляции, крупный UI)
##   PATCH — исправления, полировка, мелкий контент без смены поведения сцен

const VERSION := "0.1.0"
const PRODUCT_LINE := "Симулятор мехатронных систем"
const ORG_LINE := "ГУАП ФСПО, лаборатория МПС"


static func splash_credit() -> String:
	return "%s · %s · v%s" % [PRODUCT_LINE, ORG_LINE, VERSION]
