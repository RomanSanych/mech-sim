extends SceneTree
func _init():
	var Geom = load("res://scripts/domain/symbol_geom.gd")
	var WR = load("res://scripts/domain/wire_router_2d.gd")
	var Circ = load("res://scripts/domain/circuit.gd")
	var f = FileAccess.open("res://test/demo_shutoff.mechsim.json", FileAccess.READ)
	var data = JSON.parse_string(f.get_as_text())
	f.close()
	var circuit = Circ.new()
	circuit.from_dict(data)
	WR.invalidate()
	WR.manual_edit = true
	var wire = circuit.wires[0]
	var pts: PackedVector2Array = WR.path_for(circuit, wire)
	var a = circuit.get_element(1)
	var b = circuit.get_element(2)
	var ra = Geom.world_bounds(a).grow(10.0)
	var rb = Geom.world_bounds(b).grow(10.0)
	var pa = Geom.port_by_name(a, "out")
	var pb = Geom.port_by_name(b, "1")
	var tip_a = Geom.to_world(a, pa["local"])
	var tip_b = Geom.to_world(b, pb["local"])
	var an = (pa["normal"] as Vector2).rotated(float(a.rotation_quad) * PI * 0.5)
	var bn = (pb["normal"] as Vector2).rotated(float(b.rotation_quad) * PI * 0.5)
	var hits = WR._path_body_hits(pts, ra, rb, tip_a, tip_b, an, bn, 20.0)
	print("PATH=", pts)
	print("HITS=", hits)
	print("LEN=", Geom.path_length_px(pts))
	quit()
